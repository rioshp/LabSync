# OAuth Web client ID from the Firebase-linked Google Cloud project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Development build only. Android Emulator: 10.0.2.2. Physical device: your LAN IP.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Optional, Metro development only. Use disposable accounts without access to real classes.
# EXPO_PUBLIC values are readable in the development bundle. Do not set them for EAS/release.
EXPO_PUBLIC_DEMO_PRAKTIKAN_EMAIL=
EXPO_PUBLIC_DEMO_PRAKTIKAN_PASSWORD=
EXPO_PUBLIC_DEMO_ASISTEN_EMAIL=
EXPO_PUBLIC_DEMO_ASISTEN_PASSWORD=
