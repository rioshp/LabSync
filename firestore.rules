rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(role) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validProfile() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'role', 'createdAt'])
          && data.keys().hasOnly(['name', 'nim', 'role', 'createdAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.createdAt == request.time
          && (
            (data.role == 'asisten' && !('nim' in data))
            || (data.role == 'praktikan' && data.nim is string
              && data.nim.size() > 0 && data.nim.size() <= 30)
          );
      }

      allow get: if isOwner();
      allow create: if isOwner() && validProfile();
      allow list, update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if (hasRole('asisten') && resource.data.assistantId == request.auth.uid)
        || (hasRole('praktikan') && request.auth.uid in resource.data.get('studentIds', []));
      allow write: if false;
    }

    match /sessions/{sessionId} {
      allow read: if (hasRole('asisten') && resource.data.assistantId == request.auth.uid)
        || (hasRole('praktikan')
          && request.auth.uid in get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.get('studentIds', []));
      allow write: if false;
    }

    match /permits/{permitId} {
      function isPermitAssistant() {
        return hasRole('asisten')
          && (
            resource.data.get('assistantId', '') == request.auth.uid
            || get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.assistantId == request.auth.uid
          );
      }

      function validPermitReview() {
        let data = request.resource.data;
        return resource.data.status == 'pending'
          && data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewNote'])
          && data.reviewedBy == request.auth.uid
          && (
            (
              data.status == 'approved'
              && (
                data.reviewNote == null
                || (data.reviewNote is string && data.reviewNote.size() <= 500)
              )
            )
            || (
              data.status == 'rejected'
              && data.reviewNote is string
              && data.reviewNote.size() > 0
              && data.reviewNote.size() <= 500
            )
          );
      }

      allow read: if isPermitAssistant()
        || (hasRole('praktikan') && resource.data.studentId == request.auth.uid);
      allow update: if isPermitAssistant() && validPermitReview();
      allow create, delete: if false;
    }

    match /attendances/{attendanceId} {
      allow read: if (hasRole('praktikan') && resource.data.studentId == request.auth.uid)
        || (hasRole('asisten')
          && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.assistantId == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
